# Obtain with: curl -s https://api.ipify.org ; echo
admin_cidr = "203.0.113.10/32"

# Paste the public key only. This file is gitignored as terraform.tfvars.
ssh_public_key = "ssh-ed25519 AAAA... workstation"

# Safe default for all projects. Verify availability in your chosen region.
region     = "sfo3"
size       = "m-24vcpu-192gb"
